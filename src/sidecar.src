// sidecar.src — remotecmd pairing sidecar for tinystats.
// Exposes POST /__rcmd/pair so `remotecmd-cli sidecar activate` can provision
// a remotecmd connection on this machine without SSH access.
//
// Security:
//   Layer 1: relay URL allowlist (RCMD_ALLOWED_RELAYS env, default *.intrane.fr)
//   Layer 2: activation key (enforced by the relay)
//   Layer 3: pair code (single-use, 300s TTL, generated by `rcmd pair listen`)
//
// Flow:
//   1. rcmd pair listen --name <target> --require-activation-key → generates code
//   2. POST /__rcmd/pair {relayUrl, code, activationKey, name}
//   3. sidecar downloads rcmd binary from GitHub releases (cached)
//   4. sidecar runs: rcmd pair accept --code <code> --activation-key <key>
//   5. sidecar spawns: rcmd daemon start -daemon (detached, survives HTTP request)
//   6. daemon connects to relay → peer connected

var RCMD_GITHUB_REPO = "javimosch/remotecmd-cli"
var RCMD_RATE_LIMIT_MS = 60000
var RCMD_DEFAULT_RELAYS = "*.intrane.fr"

var sidecar_last_request = 0
var sidecar_daemon_pid = ""

// start_sidecar launches the HTTP server with the /__rcmd/pair endpoint.
func start_sidecar(port) {
	println("TinyStats sidecar running on http://localhost:" + str(port))
	println("Pairing endpoint: POST /__rcmd/pair")
	allow := env("RCMD_ALLOWED_RELAYS")
	if allow == "" {
		println("Allowlist: " + RCMD_DEFAULT_RELAYS + " (default)")
	} else {
		println("Allowlist: " + allow)
	}
	serve(port, func(req) { return sidecar_handle(req) })
}

// sidecar_handle routes requests to the pair endpoint.
func sidecar_handle(req) {
	if req.path == "/__rcmd/pair" && req.method == "POST" {
		return handle_pair(req)
	}
	if req.path == "/__rcmd/status" {
		return ok_json(sidecar_status())
	}
	return not_found()
}

// sidecar_status returns JSON about the sidecar state.
func sidecar_status() {
	pid := sidecar_daemon_pid
	status := "idle"
	if pid != "" { status = "paired" }
	return "{\"status\":\"" + status + "\",\"pid\":\"" + pid + "\"}"
}

// handle_pair processes the pairing request.
func handle_pair(req) {
	body := req.body

	// Parse request fields
	relayUrl, e1 := json_get(body, ".relayUrl")
	code, e2 := json_get(body, ".code")
	activationKey, e3 := json_get(body, ".activationKey")
	name, e4 := json_get(body, ".name")

	if e1 != "" || e2 != "" || e3 != "" || e4 != "" {
		return bad_request("missing required fields")
	}

	// Strip quotes from json_get string results
	relayUrl = unquote(relayUrl)
	code = unquote(code)
	activationKey = unquote(activationKey)
	name = unquote(name)

	if relayUrl == "" || code == "" || name == "" {
		return bad_request("relayUrl, code, and name are required")
	}

	// Layer 1: relay URL allowlist
	allowlist := get_allowed_relays()
	if !is_relay_allowed(relayUrl, allowlist) {
		return forbidden("relay not allowed")
	}

	// Rate limiting: 1 valid request per minute
	now := now_ms()
	if sidecar_last_request != 0 && now - sidecar_last_request < RCMD_RATE_LIMIT_MS {
		return too_many_requests("rate limited")
	}
	sidecar_last_request = now

	// Download rcmd binary (cached)
	binaryPath, dlErr := ensure_rcmd_binary()
	if dlErr != "" {
		return internal_error("download failed: " + dlErr)
	}

	// Step 1: pair accept
	pairCmd := binaryPath + " pair accept --code " + code
	if activationKey != "" {
		pairCmd = pairCmd + " --activation-key " + activationKey
	}
	pairCode, _, pairErr := exec(pairCmd + " 2>&1")
	if pairCode != 0 {
		return internal_error("pair accept failed: " + pairErr)
	}

	// Step 2: start daemon detached (survives this HTTP request)
	system(binaryPath + " daemon start -daemon > /dev/null 2>&1 &")

	// Give it a moment to start
	system("sleep 1")

	// Check if daemon is running
	_, psOut, _ := exec("pgrep -f 'rcmd daemon' | head -1")
	pid := trim(psOut)
	if pid != "" {
		sidecar_daemon_pid = pid
	}

	return ok_json("{\"ok\":true,\"name\":\"" + name + "\",\"pid\":\"" + pid + "\"}")
}

// get_allowed_relays parses RCMD_ALLOWED_RELAYS env var.
func get_allowed_relays() {
	raw := env("RCMD_ALLOWED_RELAYS")
	if raw == "" {
		return []string{RCMD_DEFAULT_RELAYS}
	}
	return split(raw, ",")
}

// is_relay_allowed checks if a relay URL matches the allowlist.
func is_relay_allowed(relayUrl, allowlist) {
	// Extract hostname from URL
	// URL format: http://host:port or https://host:port
	host := extract_host(relayUrl)
	if host == "" { return false }

	for _, pattern := range allowlist {
		p := trim(pattern)
		if p == "*" { return true }
		if p == relayUrl { return true }
		if starts_with(p, "*.") {
			suffix := substr(p, 1, len(p))
			if ends_with(host, suffix) { return true }
		}
		if host == p { return true }
	}
	return false
}

// extract_host pulls the hostname out of a http(s)://URL.
func extract_host(url) {
	// Strip scheme
	h := url
	if starts_with(h, "https://") {
		h = substr(h, 8, len(h))
	} else if starts_with(h, "http://") {
		h = substr(h, 7, len(h))
	}
	// Strip path
	slash := index(h, "/")
	if slash >= 0 { h = substr(h, 0, slash) }
	// Strip port
	colon := index(h, ":")
	if colon >= 0 { h = substr(h, 0, colon) }
	return h
}

// ensure_rcmd_binary downloads and caches the rcmd binary.
// Returns the path to the binary, or ("", error message).
func ensure_rcmd_binary() {
	cacheDir := env("TMPDIR")
	if cacheDir == "" { cacheDir = "/tmp" }
	binaryPath := cacheDir + "/.rcmd-cache/rcmd"

	// Check if already cached and executable
	existing := read_file_bytes(binaryPath)
	if len(existing) > 100000 {
		// Verify it's executable
		code, _, _ := exec(binaryPath + " --help 2>&1 | head -1")
		if code == 0 || code == 2 {
			return binaryPath, ""
		}
	}

	// Detect platform
	_, arch, _ := exec("uname -m")
	_, osname, _ := exec("uname -s")

	assetArch := "amd64"
	if contains(arch, "aarch64") || contains(arch, "arm64") {
		assetArch = "arm64"
	}
	assetOS := "linux"
	if contains(osname, "Darwin") { assetOS = "darwin" }

	assetName := "remotecmd-cli-" + assetOS + "-" + assetArch

	// Query GitHub API for latest release
	status, resp, e := http_get("https://api.github.com/repos/" + RCMD_GITHUB_REPO + "/releases/latest")
	if e != "" || status != 200 {
		return "", "github api error: " + e
	}

	// Find matching asset's download URL
	downloadURL := ""
	i := 0
	for i < 20 {
		assetNameVal, jerr := json_get(resp, ".assets[" + str(i) + "].name")
		if jerr != "" { break }
		if unquote(assetNameVal) == assetName {
			urlVal, uerr := json_get(resp, ".assets[" + str(i) + "].browser_download_url")
			if uerr == "" {
				downloadURL = unquote(urlVal)
			}
			break
		}
		i = i + 1
	}

	if downloadURL == "" {
		return "", "asset not found: " + assetName
	}

	// Create cache dir + download via curl (http_get truncates at NUL)
	system("mkdir -p " + cacheDir + "/.rcmd-cache")
	code := system("curl -sL -o " + binaryPath + " " + downloadURL)
	if code != 0 {
		return "", "curl failed"
	}

	// Verify download
	b := read_file_bytes(binaryPath)
	if len(b) < 100000 {
		return "", "download too small"
	}

	// Make executable
	system("chmod +x " + binaryPath)

	return binaryPath, ""
}

// unquote strips surrounding double-quotes from a json_get string result.
func unquote(s) {
	if len(s) >= 2 && starts_with(s, "\"") && ends_with(s, "\"") {
		return substr(s, 1, len(s) - 1)
	}
	return s
}

// starts_with checks if s begins with prefix.
func starts_with(s, prefix) {
	if len(prefix) > len(s) { return false }
	return substr(s, 0, len(prefix)) == prefix
}

// ends_with checks if s ends with suffix.
func ends_with(s, suffix) {
	if len(suffix) > len(s) { return false }
	return substr(s, len(s) - len(suffix), len(s)) == suffix
}

// forbidden returns a 403 response.
func forbidden(msg) {
	return response("403 Forbidden", "text/plain", msg)
}

// too_many_requests returns a 429 response.
func too_many_requests(msg) {
	return response("429 Too Many Requests", "text/plain", msg)
}

// internal_error returns a 500 response.
func internal_error(msg) {
	return response("500 Internal Server Error", "text/plain", msg)
}
